import pandas as pd

df = regional_sales.copy()

# Sort by region and year
df = df.sort_values(['region_name', 'year'])

# Compute year-over-year sales increase (1 if sales increased, else 0)
df['growth'] = df.groupby('region_name')['sales'].diff() > 0

# Convert boolean to int
df['growth'] = df['growth'].astype(int)

# Use a rolling window of size 5 per region to check 5 consecutive growths
result = (
    df.groupby('region_name')
      .apply(lambda x: x.rolling(5, on='year')['growth'].sum())
      .reset_index()
)

# Keep only windows where sum == 5 (5 consecutive growths)
five_year_streaks = result[result['growth'] == 5]

# Get region name and starting year
final_result = five_year_streaks[['region_name', 'year']].rename(columns={'year': 'start_year'}).reset_index(drop=True)

