import pandas as pd

# Assume your dataframe is called regional_sales
df = regional_sales.copy()

# Step 1: Sort by region and year
df = df.sort_values(by=['region_name', 'year'])

# Step 2: Previous year sales
df['prev_sales'] = df.groupby('region_name')['sales'].shift(1)
df['prev_year'] = df.groupby('region_name')['year'].shift(1)

# Step 3: Check year-over-year growth and consecutive years
df['valid_growth'] = ((df['sales'] > df['prev_sales']) & (df['year'] - df['prev_year'] == 1)).astype(int)

# Step 4: Create streak groups for uninterrupted growth
df['streak_group'] = df.groupby('region_name')['valid_growth'].transform(lambda x: (x == 0).cumsum())

# Step 5: Count the length of each growth streak and record starting year
streaks = (
    df[df['valid_growth'] == 1]
    .groupby(['region_name', 'streak_group'])
    .agg(
        streak_len=('year', 'count'),
        start_year=('year', 'min')
    )
    .reset_index()
)

# Step 6: Keep only streaks of length >= 5
result = streaks[streaks['streak_len'] >= 5][['region_name', 'start_year']]

